{
  "description": "Bolta safety gates: confirm any public, irreversible or approving Bolta action, and tell the user when the connection has expired",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__[A-Za-z0-9_-]*[Bb]olta[A-Za-z0-9_-]*__(publish-post|schedule-post|approve-post|approve-recurring-review|send-outreach-reply|publish-engagement-reply|reply-to-social-content|react-to-social-content|activate-routine|resume-routine|run-routine-now|delete-post|archive-routine|set-content-campaign-status|update-post|update-business-dna|update-voice-profile|create-routine|update-routine|create-post|bulk-create-posts|create-wordpress-blog-post)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-bolta-writes.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__[A-Za-z0-9_-]*[Bb]olta[A-Za-z0-9_-]*__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bolta-auth-notice.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
