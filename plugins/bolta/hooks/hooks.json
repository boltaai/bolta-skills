{
  "description": "Bolta checks: ask before anything public, approved, final, credit-spending right now, or changing what drafts are written from; one check per batch of approvals, reset on every message.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__[A-Za-z0-9_-]*[Bb][Oo][Ll][Tt][Aa][A-Za-z0-9_-]*__(publish-post|schedule-post|approve-post|approve-recurring-review|reject-recurring-review|send-outreach-reply|publish-engagement-reply|reply-to-social-content|react-to-social-content|activate-routine|resume-routine|run-routine-now|delete-post|archive-routine|set-content-campaign-status|update-post|update-post-platform-details|update-social-bucket|restore-deleted|update-business-dna|extract-business-dna|update-voice-profile|create-routine|update-routine|create-post|bulk-create-posts|create-wordpress-blog-post|voice-generate)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-bolta-writes.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__[A-Za-z0-9_-]*[Bb][Oo][Ll][Tt][Aa][A-Za-z0-9_-]*__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bolta-auth-notice.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__[A-Za-z0-9_-]*[Bb][Oo][Ll][Tt][Aa][A-Za-z0-9_-]*__(approve-post|approve-recurring-review|schedule-post|delete-post|create-routine|update-routine)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bolta-mark.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__[A-Za-z0-9_-]*[Bb][Oo][Ll][Tt][Aa][A-Za-z0-9_-]*__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bolta-auth-notice.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bolta-new-turn.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bolta-house-rules.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
